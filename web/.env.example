# === Required (local + Vercel) ===
DATABASE_URI=postgresql://user:password@host/neondb?sslmode=require
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# === Inquiry email (full feature — configure for 转正, optional while learning) ===
# Resend free tier can send to your personal Gmail for practice.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=your@gmail.com
INQUIRY_FROM_EMAIL=onboarding@resend.dev

# === Spam protection (recommended for production) ===
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# === Machine translation (optional; without keys, locales copy English) ===
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=

# === Contact / branding ===
NEXT_PUBLIC_WHATSAPP_NUMBER=8613800000000
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123
